{
  "name": "MR/ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "vue-tsc --noEmit -p tsconfig.json && tsup && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.9.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "unplugin-vue": "^6.0.0",
    "vue-tsc": "^3.3.11"
  }
}
